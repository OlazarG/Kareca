# Application Port
PORT=3000

# Database Configuration
# In Render, you can use DATABASE_URL or individual variables.
# The app is currently configured to use individual variables, 
# but you should prefer DATABASE_URL in cloud environments.

DB_USER=your_user
DB_HOST=your_host
DB_NAME=your_database
DB_PASSWORD=your_password
DB_PORT=5432

# Option: DATABASE_URL (for cloud deployment)
# DATABASE_URL=postgres://user:password@host:port/database?sslmode=require
